# 火山引擎 语音合成（豆包 TTS）凭证，二选一
# 新版控制台：API Key
VOLC_TTS_API_KEY=
# 旧版控制台：App ID + Access Token
VOLC_TTS_APP_ID=
VOLC_TTS_ACCESS_TOKEN=

# 资源 ID：官方 2.0 音色（*_uranus_bigtts）填 seed-tts-2.0；声音复刻音色（S_ 开头）填 volc.megatts.default
VOLC_TTS_RESOURCE_ID=seed-tts-2.0
# 音色 ID：在火山音色广场复制；用自己的声音就填声音复刻得到的 S_ 开头 ID
VOLC_TTS_VOICE=zh_male_liufei_uranus_bigtts
